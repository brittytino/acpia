# ============================================================
# ACPIA — Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=acpia
POSTGRES_USER=acpia_user
POSTGRES_PASSWORD=change_me_postgres_secret

# --- Neo4j ---
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me_neo4j_secret
NEO4J_AUTH=neo4j/change_me_neo4j_secret

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- MinIO ---
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change_me_minio_secret
MINIO_BUCKET=acpia-evidence
MINIO_SECURE=false

# --- OpenSearch ---
OPENSEARCH_HOST=opensearch
OPENSEARCH_PORT=9200
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=change_me_opensearch_secret

# --- Keycloak ---
KEYCLOAK_SERVER_URL=http://keycloak:8080
KEYCLOAK_REALM=acpia
KEYCLOAK_CLIENT_ID=acpia-backend
KEYCLOAK_CLIENT_SECRET=change_me_keycloak_secret
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change_me_keycloak_admin

# --- Ollama ---
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_LLM_MODEL=llama3.1:8b
OLLAMA_VISION_MODEL=llava:13b

# --- FastAPI ---
SECRET_KEY=change_me_super_secret_key_at_least_32_chars
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false
CORS_ORIGINS=http://localhost:3000,http://frontend:3000

# --- Celery ---
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Whisper ---
WHISPER_MODEL=base
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16

# --- Prometheus ---
PROMETHEUS_PORT=9090

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_grafana_secret

# --- Application ---
ENVIRONMENT=production
LOG_LEVEL=INFO
HASH_LIST_PATH=/data/known_hashes/hash_list.txt
