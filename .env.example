# VERITAS — root environment template (used by docker-compose.yml)
# Copy to .env — never commit .env itself.

POSTGRES_DB=acpia
POSTGRES_USER=acpia
POSTGRES_PASSWORD=change-me                 # openssl rand -base64 24
DB_APP_PASSWORD=change-me-too                # openssl rand -base64 24 — least-privilege app role
JWT_SECRET=change-me-to-a-long-random-string # openssl rand -base64 48

# Never enable against a database holding real cases — creates well-known
# demo accounts (admin/investigator1/supervisor1/auditor1, see backend/scripts/seed.py)
SEED_DEMO_USERS=false

# Explicit origin allowlist — JSON array string. Never "*" (see docker-compose.yml comment).
CORS_ORIGINS=["http://localhost:47803","http://localhost:47804"]

SEAL_URL=http://localhost:47803
CONSOLE_URL=http://localhost:47804

# SMTP — leave SMTP_ENABLED=false unless you set real credentials below.
# NEVER put a real password in this file — it's tracked by git. Put the
# real value in backend/.env (gitignored) or, for Azure, in the App
# Service's Application Settings / Key Vault reference.
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx
SMTP_FROM=VERITAS ACPIA <your-gmail@gmail.com>

# Full backend settings live in backend/.env — see backend/.env.example
# Frontend settings live in seal/.env.local and police-console/.env.local
