# ACPIA — Environment Template
# Copy this to .env and fill in your values
# NEVER commit .env — only this .env.example file

# ─── TINO's Server IP (update this if it changes) ────────────────────────────
# Run: ip addr | grep "inet " on Tino's laptop to get this
TINO_SERVER_IP=192.168.11.209

# ─── Postgres ─────────────────────────────────────────────────────────────────
POSTGRES_DB=acpia
POSTGRES_USER=acpia_user
POSTGRES_PASSWORD=acpia$3cret2024!
POSTGRES_HOST=192.168.11.209   # Barath/Chinnaya use Tino's IP; Tino uses localhost
POSTGRES_PORT=54327

# ─── Neo4j ────────────────────────────────────────────────────────────────────
NEO4J_URI=bolt://192.168.11.209:7688
NEO4J_USER=neo4j
NEO4J_PASSWORD=acpiaGraph!2024

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://192.168.11.209:63799/0
CELERY_BROKER_URL=redis://192.168.11.209:63799/1
CELERY_RESULT_BACKEND=redis://192.168.11.209:63799/2

# ─── MinIO ────────────────────────────────────────────────────────────────────
MINIO_ENDPOINT=192.168.11.209:9200
MINIO_ACCESS_KEY=acpiaMinio
MINIO_SECRET_KEY=acpiaMinioSec2024!
MINIO_BUCKET_NAME=acpia-evidence
MINIO_SECURE=false

# ─── Keycloak Auth ────────────────────────────────────────────────────────────
KEYCLOAK_SERVER_URL=http://192.168.11.209:8180
KEYCLOAK_REALM=acpia
KEYCLOAK_CLIENT_ID=acpia-backend
KEYCLOAK_CLIENT_SECRET=acpia-backend-secret

# ─── Ollama AI (ONLY on Tino's machine with GPU) ──────────────────────────────
OLLAMA_BASE_URL=http://192.168.11.209:11535
LLM_MODEL=llama3.1:8b
VISION_MODEL=llava:7b
EMBED_MODEL=nomic-embed-text

# ─── Backend ──────────────────────────────────────────────────────────────────
BACKEND_PORT=8765
DATABASE_URL=postgresql+asyncpg://acpia_user:acpia$3cret2024!@192.168.11.209:54327/acpia
DATABASE_URL_SYNC=postgresql://acpia_user:acpia$3cret2024!@192.168.11.209:54327/acpia
SECRET_KEY=acpia-super-secret-jwt-key-2024-hackathon-srcas
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
MAX_UPLOAD_SIZE_MB=500

# ─── Frontend (Chinnaya) ──────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://192.168.11.209:8765
NEXT_PUBLIC_WS_URL=ws://192.168.11.209:8765
NEXT_PUBLIC_KEYCLOAK_URL=http://192.168.11.209:8180
NEXT_PUBLIC_KEYCLOAK_REALM=acpia
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=acpia-frontend

# ─── Observability ────────────────────────────────────────────────────────────
GRAFANA_PORT=3838
PROMETHEUS_PORT=9191
