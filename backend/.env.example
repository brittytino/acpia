# VERITAS — Backend .env template
# Copy to backend/.env — never commit .env itself.

ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string   # openssl rand -base64 48
BACKEND_PORT=47802
MAX_UPLOAD_SIZE_MB=500

DATABASE_URL=postgresql+asyncpg://acpia:password@localhost:47800/acpia
DATABASE_URL_SYNC=postgresql://acpia:password@localhost:47800/acpia

# AI — OpenRouter (text + vision, free 5-model fallback chain) + Gemini
# (embeddings only — OpenRouter has no embeddings endpoint). Both free.
OPENROUTER_API_KEY=                          # https://openrouter.ai/keys
GEMINI_API_KEY=                              # https://aistudio.google.com/apikey

# Evidence file storage — Cloudinary free tier (no persistent disk on
# Render's free web service, so uploaded evidence lives here instead)
CLOUDINARY_URL=                              # https://cloudinary.com/console

JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

CORS_ORIGINS=["http://localhost:47803","http://localhost:47804","http://127.0.0.1:47803","http://127.0.0.1:47804"]

SEAL_URL=http://localhost:47803
CONSOLE_URL=http://localhost:47804

# ── SMTP Email (Gmail App Password) ──────────────────────────────────────
# To enable emails:
#   1. Go to https://myaccount.google.com/apppasswords
#   2. Create an App Password for "Mail"
#   3. Fill in the values below and set SMTP_ENABLED=True
#
SMTP_ENABLED=False
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx
SMTP_FROM=VERITAS ACPIA <your-gmail@gmail.com>
