# VERITAS — Backend .env template
# Copy to backend/.env — never commit .env itself.

ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string   # openssl rand -base64 48
BACKEND_PORT=47802
MAX_UPLOAD_SIZE_MB=500
STORAGE_PATH=./storage

DATABASE_URL=postgresql+asyncpg://acpia:password@localhost:47800/acpia
DATABASE_URL_SYNC=postgresql://acpia:password@localhost:47800/acpia

OLLAMA_BASE_URL=http://localhost:47801
VISION_MODEL=moondream
LLM_MODEL=qwen2.5:3b
EMBED_MODEL=nomic-embed-text

JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

CORS_ORIGINS=["http://localhost:47803","http://localhost:47804","http://127.0.0.1:47803","http://127.0.0.1:47804"]

SEAL_URL=http://localhost:47803
CONSOLE_URL=http://localhost:47804
